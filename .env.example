# Copy to .env if you want hosted models or live search.
# The default mock providers run with no keys.

LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# How many times the critic may send the brief back to the writer.
MAX_REVISIONS=1
SEARCH_RESULTS_PER_QUERY=3
CORS_ORIGINS=http://localhost:3000

# Browser-facing API URL baked into the Next.js app at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
